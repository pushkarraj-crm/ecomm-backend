# Copy to .env and replace values for your environment.
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080

# Database settings. SQLite is the local default; configure the fields below
# when using PostgreSQL, MySQL, or another Django database backend.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_CONN_MAX_AGE=0

# Shared Redis is required by the Docker deployment for cache and throttles.
# Leave REDIS_URL blank for local development without Redis.
REDIS_URL=
REDIS_PASSWORD=
REDIS_CACHE_TTL=60
CACHE_KEY_PREFIX=d2c-marketplace
PRODUCT_CACHE_TTL_SECONDS=30

# Docker Compose uses PostgreSQL and overrides the local DB_* values above.
POSTGRES_DB=marketplace
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=

# Rate limits (DRF syntax: count/second, minute, hour, or day).
API_ANON_RATE=120/minute
API_USER_RATE=1200/hour
API_REGISTER_RATE=5/hour
API_LOGIN_RATE=10/minute
API_PASSWORD_RESET_RATE=5/hour
PRODUCT_TRACKING_RATE=1200/hour
TRUSTED_PROXY_COUNT=0
TRUST_PROXY_SSL=False

# Catalog pagination and container server sizing.
API_PAGE_SIZE=24
API_MAX_PAGE_SIZE=100
LOW_STOCK_THRESHOLD=5
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
HTTP_PORT=8080

# Razorpay test or live credentials. Keep the secret server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email configuration. For local development, use Django's console backend.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
